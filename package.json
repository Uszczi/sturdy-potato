{
  "name": "sturdy-potato",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write templates assets e2e tests vite.config.mjs playwright.config.ts package.json aspire.config.json docker-compose.yml",
    "format:check": "prettier --check templates assets e2e tests vite.config.mjs playwright.config.ts package.json aspire.config.json docker-compose.yml",
    "aspire:start": "npm --prefix aspire-apphost run aspire:start",
    "aspire:build": "npm --prefix aspire-apphost run aspire:build",
    "aspire:dev": "npm --prefix aspire-apphost run aspire:dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uszczi/sturdy-potato.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Uszczi/sturdy-potato/issues"
  },
  "homepage": "https://github.com/Uszczi/sturdy-potato#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "alpinejs": "^3.16.1",
    "daisyui": "^5.7.17",
    "htmx.org": "^2.0.10",
    "idiomorph": "^0.7.4",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  }
