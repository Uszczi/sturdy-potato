{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // Off because `src` imports the autogenerated `api-client`, which pulls the
    // generated .ts into this program. openapi-generator's output has unused
    // imports/params that can't be edited (they're regenerated), and `exclude`
    // can't drop imported files. Unused-var linting is handled by oxlint.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Off for the same reason: the generated client uses non-erasable syntax
    // (e.g. constructor parameter properties in runtime.ts).
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@api-client": ["api-client"]
    }
  },
  "include": ["src"]
}
